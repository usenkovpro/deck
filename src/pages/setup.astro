---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const example = JSON.stringify(
  {
    slots: [
      { n: 1, start: "07:50", end: "08:45" },
      { n: 2, start: "08:45", end: "09:40" },
      { n: 3, start: "09:40", end: "09:55", type: "break", label: "Break" },
    ],
    days: {
      Mon: [
        { n: 1, subject: "Computer Science", teacher: "Mrs R Chaudhry", room: "2011" },
        { n: 2, subject: "Music", teacher: "Mr N Jackson", room: "1060" },
      ],
      Tue: [],
    },
  },
  null,
  2,
);
---

<BaseLayout title="Setup — Deck">
  <h2 class="section" style="font-size: var(--t-lg)">Your timetable</h2>
  <p class="note">
    Everything you put here is saved on this device only. Deck makes no network
    requests and there is no account — nothing you type is ever uploaded.
  </p>

  <div id="current"></div>

  <div class="section">
    <label class="label" for="json">Paste timetable JSON</label>
    <textarea id="json" spellcheck="false" autocapitalize="off" autocorrect="off"
      placeholder="Paste your timetable here"></textarea>
    <div class="btn-row">
      <button class="btn" id="import" type="button">Import</button>
      <button class="btn secondary" id="export" type="button">Export current</button>
      <button class="btn danger" id="clear" type="button">Delete</button>
    </div>
    <div id="message" hidden></div>
  </div>

  <details>
    <summary>What the JSON should look like</summary>
    <p>
      <code>slots</code> are the period times, shared by every day. <code>days</code>
      says which subject sits in which period. A period with no lesson shows as free,
      and a day you leave out is a day with no school.
    </p>
    <pre>{example}</pre>
  </details>

  <p class="section note">
    <a href={base}>Back to today</a>
  </p>
</BaseLayout>

<script>
  import {
    loadTimetable,
    saveTimetable,
    clearTimetable,
    parseTimetable,
  } from "../lib/storage";
  import { subjectsInOrder, entriesFor } from "../lib/schedule";
  import { SCHOOL_DAYS, type Timetable } from "../lib/types";
  import { el } from "../lib/render";

  const textarea = document.getElementById("json") as HTMLTextAreaElement;
  const message = document.getElementById("message")!;
  const current = document.getElementById("current")!;
  const importBtn = document.getElementById("import") as HTMLButtonElement;
  const exportBtn = document.getElementById("export") as HTMLButtonElement;
  const clearBtn = document.getElementById("clear") as HTMLButtonElement;

  function say(text: string, isError = false): void {
    message.hidden = false;
    message.className = isError ? "message is-error" : "message";
    message.textContent = text;
  }

  /** "5 days · 33 lessons · 16 subjects" */
  function describe(tt: Timetable): string {
    const days = SCHOOL_DAYS.filter((d) => entriesFor(tt, d).length > 0);
    const lessons = days.reduce(
      (total, day) => total + entriesFor(tt, day).filter((e) => e.kind === "lesson").length,
      0,
    );
    const subjects = subjectsInOrder(tt).length;
    return `${days.length} days · ${lessons} lessons · ${subjects} subjects`;
  }

  function paintCurrent(): void {
    const tt = loadTimetable();
    if (!tt) {
      current.replaceChildren(
        el("p", "note", "Nothing saved on this device yet."),
      );
      exportBtn.disabled = true;
      clearBtn.disabled = true;
      return;
    }
    const box = el("div", "message");
    box.append(el("strong", undefined, "Saved: "));
    box.append(document.createTextNode(describe(tt)));
    current.replaceChildren(box);
    exportBtn.disabled = false;
    clearBtn.disabled = false;
  }

  importBtn.addEventListener("click", () => {
    const text = textarea.value.trim();
    if (!text) {
      say("Paste your timetable JSON into the box first.", true);
      return;
    }

    let data: unknown;
    try {
      data = JSON.parse(text);
    } catch (error) {
      say(`That is not valid JSON. ${(error as Error).message}`, true);
      return;
    }

    const result = parseTimetable(data);
    if (!result.ok) {
      say(result.error, true);
      return;
    }

    saveTimetable(result.value);
    textarea.value = "";
    paintCurrent();
    say(`Imported. ${describe(result.value)}`);
  });

  exportBtn.addEventListener("click", () => {
    const tt = loadTimetable();
    if (!tt) return;
    textarea.value = JSON.stringify(tt, null, 2);
    textarea.focus();
    textarea.select();
    say("Your timetable is in the box above — copy it somewhere safe.");
  });

  // Two taps to delete. A confirm dialog is easy to dismiss by accident on a phone.
  let armed = false;
  clearBtn.addEventListener("click", () => {
    if (!armed) {
      armed = true;
      clearBtn.textContent = "Tap again to delete";
      setTimeout(() => {
        armed = false;
        clearBtn.textContent = "Delete";
      }, 4000);
      return;
    }
    clearTimetable();
    armed = false;
    clearBtn.textContent = "Delete";
    paintCurrent();
    say("Deleted from this device.");
  });

  paintCurrent();
</script>
